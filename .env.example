# Database
DATABASE_URL=postgresql+asyncpg://pycon_admin:password@db:5432/pyconci

# JWT
JWT_SECRET_KEY=change_me_super_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# Frontend (utilisé pour construire le lien de réinitialisation du mot de passe)
FRONTEND_URL=http://localhost:3000

# SMTP (laisser SMTP_HOST vide pour afficher les emails dans la console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# STARTTLS sur le port 587 ; pour le port 465 mettre SMTP_USE_SSL=true
SMTP_STARTTLS=true
SMTP_USE_SSL=false

# GeniusPay
GENIUSPAY_API_KEY=pk_sandbox_example
GENIUSPAY_API_SECRET=sk_sandbox_example
GENIUSPAY_WEBHOOK_SECRET=wh_sandbox_example
GENIUSPAY_ENVIRONMENT=sandbox

# App
APP_HOST=0.0.0.0
APP_PORT=8000
