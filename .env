# Lancement local (uvicorn sous Windows) : base Docker exposée sur 5433 via pyconci_db_proxy.
# Dans Docker, utiliser : postgresql+asyncpg://pycon_admin:password@db:5432/pyconci
DATABASE_URL=postgresql+asyncpg://pycon_admin:password@127.0.0.1:5433/pyconci

# SMTP (envoi des emails). Vider SMTP_HOST pour revenir à l'affichage console.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Adresse du compte qui envoie
SMTP_USER=md01438743@gmail.com
# Mot de passe d'application Gmail (16 caractères), pas le mot de passe du compte
SMTP_PASSWORD=mkch qzgw oiho lrie
# Expéditeur affiché, ex : PyCon CI <adresse@gmail.com> (par défaut : SMTP_USER)
SMTP_FROM=
SMTP_STARTTLS=true
SMTP_USE_SSL=false

# Adresse du site, utilisée dans le lien de réinitialisation du mot de passe
FRONTEND_URL=http://localhost:3000
JWT_SECRET_KEY=change_me_super_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
